# reconstruir y lo necesita el modo road.
outputs/models/
outputs/figures/
outputs/route_*.csv
outputs/metrics_*.json

# Artefactos temporales de verificación / notebooks ejecutados
outputs/_*
outputs/*_check.ipynb
outputs/*_run*.ipynb

# Artefactos de workflows
.agents/

# Caché de herramientas externas (raíz)
/cache/
