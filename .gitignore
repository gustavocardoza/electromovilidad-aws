# Entorno virtual
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Datos de entrada (muy pesados, ~5 GB; viven en el disco, fuera de git)
data/

# Resultados y modelos generados por el solver (se regeneran con src.solve).
